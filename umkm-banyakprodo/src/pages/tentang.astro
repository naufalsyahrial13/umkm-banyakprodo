---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tentang Kami - Tim KKN Desa Banyakprodo">
  <main class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <div class="text-center space-y-3">
        <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full">KKN Tim II Universitas Diponegoro</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Tim Pengembang Website</h1>
        <p class="text-slate-600">Tim Mahasiswa KKN UNDIP Desa Banyakprodo, Kecamatan Tirtomoyo, Wonogiri.</p>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 space-y-6">
        <h2 class="text-xl font-bold text-slate-800 border-b pb-3 border-slate-100">Komitmen Kami</h2>
        <p class="text-slate-600 leading-relaxed">
          Website Direktori UMKM ini dirancang dan dibangun sebagai bagian dari program kerja digitalisasi UMKM Desa Banyakprodo. Tujuan utama kami adalah membantu pelaku usaha lokal agar memiliki visibilitas digital yang lebih luas dan mudah dijangkau oleh konsumen secara umum.
        </p>
      </div>

      <!-- KARTU TIM (Bisa disesuaikan nama & fotonya nanti) -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200">
        <h2 class="text-xl font-bold text-slate-800 mb-6">Anggota Tim KKN</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="w-12 h-12 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center">
              TIM
            </div>
            <div>
              <h3 class="font-bold text-slate-800">Tim KKN Desa Banyakprodo</h3>
              <p class="text-xs text-slate-500">Universitas Diponegoro</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>