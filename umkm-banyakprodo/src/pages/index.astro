---
import Layout from '../layouts/Layout.astro';
import umkmData from '../data/umkm.json';

const totalUmkm = umkmData.length;
const totalKategori = new Set(umkmData.map(u => u.kategori)).size;
const totalHalal = umkmData.filter(u => u.halal).length;

// Mengambil kategori unik selain 'Semua' untuk bagian kartu kategori
const listKategoriUnik = [...new Set(umkmData.map(u => u.kategori))];
---

<Layout title="Direktori UMKM Desa Banyakprodo">
  <main class="min-h-screen bg-slate-50 text-slate-800">
    
    <!-- HERO SECTION -->
    <section class="bg-gradient-to-r from-emerald-700 to-teal-800 text-white py-16 px-4 sm:px-6 lg:px-8 shadow-md">
      <div class="max-w-6xl mx-auto text-center space-y-4">
        <span class="inline-block bg-emerald-600/60 backdrop-blur-sm text-emerald-100 text-sm font-semibold px-4 py-1.5 rounded-full border border-emerald-400/30">
          Official Directory • KKN Universitas Diponegoro
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
          Direktori UMKM Desa Banyakprodo
        </h1>
        <p class="text-emerald-100 text-lg max-w-2xl mx-auto font-light">
          Mendukung potensi produk lokal, kerajinan, dan kuliner unggulan warga Desa Banyakprodo, Kecamatan Tirtomoyo, Wonogiri.
        </p>
      </div>
    </section>

    <!-- STATISTIK RINGKAS -->
    <section class="max-w-6xl mx-auto -mt-8 px-4 sm:px-6 relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 bg-white p-6 rounded-2xl shadow-lg border border-slate-100">
        <div class="text-center p-3">
          <p class="text-3xl font-black text-emerald-600">{totalUmkm}</p>
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Total UMKM Terdata</p>
        </div>
        <div class="text-center p-3 border-x border-slate-100">
          <p class="text-3xl font-black text-emerald-600">{totalKategori}</p>
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Sektor Kategori</p>
        </div>
        <div class="text-center p-3 col-span-2 md:col-span-1 border-t md:border-t-0 border-slate-100">
          <p class="text-3xl font-black text-emerald-600">{totalHalal}</p>
          <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Tersertifikasi Halal</p>
        </div>
      </div>
    </section>

    <!-- TENTANG DESA (BARU) -->
    <section id="tentang-desa" class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-slate-200 flex flex-col lg:flex-row gap-10 items-center">
        <div class="lg:w-1/2 space-y-5">
          <div class="inline-flex items-center justify-center p-3 bg-blue-50 text-blue-600 rounded-xl mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-slate-900">Tentang Desa Banyakprodo</h2>
          <p class="text-slate-600 leading-relaxed">
            Desa Banyakprodo terletak di Kecamatan Tirtomoyo, Kabupaten Wonogiri. Di wilayah ini berkembang berbagai Usaha Mikro, Kecil, dan Menengah (UMKM) yang menjadi penopang perekonomian masyarakat setempat.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Keberadaan UMKM ini tidak hanya membantu meningkatkan pendapatan warga, tetapi juga mendorong terciptanya lapangan kerja baru serta memperkenalkan kearifan lokal Banyakprodo ke khalayak luas.
          </p>
        </div>
        
        <!-- Placeholder Peta -->
        <div class="lg:w-1/2 w-full">
          <div class="relative bg-slate-200 rounded-2xl h-72 w-full flex flex-col items-center justify-center border-4 border-white shadow-lg overflow-hidden group cursor-pointer hover:bg-slate-300 transition-colors">
            <!-- Nanti gambar peta aslinya dimasukkan ke sini -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-slate-400 mb-2 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-slate-500 font-medium">Klik untuk perbesar peta Banyakprodo</span>
            <span class="text-slate-400 text-xs mt-1">(Gambar peta belum dimasukkan)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- KATEGORI UMKM (BARU) -->
    <section class="bg-slate-100 py-16 border-y border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-slate-900">Kategori UMKM</h2>
          <p class="text-slate-500 mt-2">Temukan berbagai jenis usaha lokal yang berkembang di Desa Banyakprodo</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {listKategoriUnik.map((kategori) => (
            <a href="#katalog" class="bg-white rounded-2xl p-8 text-center shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-slate-200 group flex flex-col items-center gap-4">
              <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center group-hover:bg-emerald-600 transition-colors">
                <span class="text-emerald-600 font-bold text-xl group-hover:text-white">
                  {kategori.charAt(0)}
                </span>
              </div>
              <div>
                <h3 class="font-bold text-xl text-slate-800">{kategori}</h3>
                <p class="text-slate-500 text-sm mt-1">Lihat produk di kategori ini</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- KATALOG UMKM (Versi Lama Tetap Ada) -->
    <section id="katalog" class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-slate-900">Daftar Usaha Lokal</h2>
        <p class="text-slate-500 mt-2">Katalog lengkap produk kebanggaan warga Banyakprodo</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {umkmData.map((item) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
              <img src={item.gambar} alt={item.nama} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-slate-800 text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm">{item.kategori}</span>
              {item.halal && (
                <span class="absolute top-3 right-3 bg-emerald-600 text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-sm">✓ HALAL</span>
              )}
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-slate-900">{item.nama}</h3>
                <p class="text-xs text-slate-400 font-medium mb-2">Pemilik: {item.pemilik}</p>
                <p class="text-slate-600 text-sm line-clamp-2 mb-4">{item.deskripsi}</p>
              </div>
              <div class="pt-4 border-t border-slate-100 space-y-3">
                <div class="flex justify-between items-center text-xs">
                  <span class="text-slate-400">Kisaran Harga:</span>
                  <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-1 rounded">{item.harga}</span>
                </div>
                <a href={`/umkm/${item.id}`} class="w-full mt-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-4 rounded-xl text-xs flex items-center justify-center transition-colors">
  Lihat Detail & Kontak
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 py-8 px-4 text-center text-xs border-t border-slate-800">
      <p>© 2026 Tim KKN Desa Banyakprodo • Kecamatan Tirtomoyo, Kabupaten Wonogiri</p>
    </footer>

  </main>
</Layout>