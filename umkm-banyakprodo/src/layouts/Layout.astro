---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';

// Memanggil komponen Navbar yang tadi kita buat
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="id" class="scroll-smooth"> <!-- scroll-smooth agar efek meluncur halus -->
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Direktori UMKM Desa Banyakprodo" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 antialiased">
    
    <!-- Menampilkan Navbar di paling atas -->
    <Navbar />
    
    <!-- Tempat di mana konten halaman (seperti index.astro) akan dirender -->
    <slot />

  </body>
</html>