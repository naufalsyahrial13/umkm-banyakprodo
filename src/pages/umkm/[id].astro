---
import Layout from '../../layouts/Layout.astro';
import UmkmCard from '../../components/umkm/UmkmCard.astro';
import GaleriFoto from '../../components/umkm/GaleriFoto.astro';
import VideoUsaha from '../../components/umkm/VideoUsaha.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import umkmData from '../../data/umkm.json';

export async function getStaticPaths() {
  return umkmData.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;

const umkmSejenis = umkmData.filter(
  (u) => u.kategori === item.kategori && u.id !== item.id
);
---

<Layout
  title={`${item.nama} - Detail UMKM Banyakprodo`}
  description={item.deskripsi}
  gambar={item.galeri?.[0]}
>
  <main class="min-h-screen bg-canvas py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-8">

      <Breadcrumb items={[
        { label: "Beranda", href: "/" },
        { label: "Katalog UMKM", href: "/#katalog" },
        { label: item.nama },
      ]} />

      <div class="reveal bg-surface rounded-3xl overflow-hidden shadow-sm border border-line">
        <div class="relative">
          <GaleriFoto gambar={item.galeri} nama={item.nama} />

          <span class="absolute top-4 left-4 bg-surface/90 backdrop-blur-md text-ink text-sm font-bold px-3 py-1 rounded-lg shadow-sm z-30">
            {item.kategori}
          </span>

          {item.halal && (
            <span class="absolute top-4 right-4 bg-sawah-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm z-30">
              ✓ Tersertifikasi Halal
            </span>
          )}

          <span
            id="statusBukaTutup"
            class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 bg-surface/90 backdrop-blur-md text-ink-soft text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm z-30"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-ink-faint"></span>
            Memuat status...
          </span>
        </div>

        <div class="p-6 sm:p-8 space-y-6">
          <div>
            <h1 class="text-3xl font-extrabold text-ink">{item.nama}</h1>
            <p class="text-ink-soft font-medium mt-1">Pemilik Usaha: <span class="text-ink">{item.pemilik}</span></p>
            <p class="text-ink-soft text-sm mt-1 flex items-center gap-1">
              📍 {item.dusun} · {item.alamatDetail}
            </p>
          </div>

          <div class="border-y border-line py-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <span class="text-xs text-ink-faint font-medium block">Kisaran Harga</span>
              <span class="text-lg font-bold text-soga-600">{item.harga}</span>
            </div>

            <div>
              <span class="text-xs text-ink-faint font-medium block mb-1">Metode Pembayaran</span>
              <div class="flex gap-2 flex-wrap">
                {item.pembayaran?.cash && (
                  <span class="bg-canvas text-ink-soft text-xs font-bold px-2.5 py-1 rounded-lg border border-line">
                    💵 Cash
                  </span>
                )}
                {item.pembayaran?.qris && (
                  <span class="bg-indigo-50 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-lg border border-indigo-100">
                    📱 QRIS
                  </span>
                )}
                {item.pembayaran?.transfer && (
                  <span class="bg-sawah-50 text-sawah-600 text-xs font-bold px-2.5 py-1 rounded-lg border border-sawah-100">
                    🏦 Transfer
                  </span>
                )}
                {!item.pembayaran?.cash && !item.pembayaran?.qris && !item.pembayaran?.transfer && (
                  <span class="text-ink-faint text-xs font-medium">Belum diketahui</span>
                )}
              </div>
            </div>
          </div>

          {(item.instagram || item.facebook || item.tiktok) && (
            <div>
              <span class="text-xs text-ink-faint font-medium block mb-1">Sosial Media</span>
              <div class="flex gap-4 flex-wrap">
                {item.instagram && (
                  <a href={`https://instagram.com/${item.instagram}`} target="_blank" class="text-pink-600 hover:text-pink-700 font-semibold text-sm">
                    📸 Instagram
                  </a>
                )}
                {item.facebook && (
                  <a href={`https://facebook.com/${item.facebook}`} target="_blank" class="text-indigo-600 hover:text-indigo-700 font-semibold text-sm">
                    🌐 Facebook
                  </a>
                )}
                {item.tiktok && (
                  <a href={`https://tiktok.com/@${item.tiktok}`} target="_blank" class="text-ink hover:text-ink-soft font-semibold text-sm">
                    🎵 TikTok
                  </a>
                )}
              </div>
            </div>
          )}

          <div class="space-y-2">
            <h2 class="text-lg font-bold text-ink">Deskripsi Usaha</h2>
            <p class="text-ink-soft leading-relaxed">{item.deskripsi}</p>
          </div>

          {item.video && (
            <div class="space-y-2">
              <h2 class="text-lg font-bold text-ink">Video Profil Usaha</h2>
              <VideoUsaha videoId={item.video} judul={item.nama} />
            </div>
          )}

          <div class="bg-canvas rounded-2xl p-5 grid grid-cols-2 sm:grid-cols-4 gap-4 border border-line">
            <div>
              <span class="text-xs text-ink-faint font-medium block">Dusun</span>
              <span class="text-sm font-bold text-ink">{item.dusun}</span>
            </div>
            <div>
              <span class="text-xs text-ink-faint font-medium block">Kategori</span>
              <span class="text-sm font-bold text-ink">{item.kategori}</span>
            </div>
            <div>
              <span class="text-xs text-ink-faint font-medium block">Sertifikasi</span>
              <span class="text-sm font-bold text-ink">
                {item.halal ? "Halal" : "-"}{item.nib ? " · NIB" : ""}
              </span>
              {item.nib && item.nomorNib && (
                <span class="text-[11px] text-ink-faint block mt-0.5">No. {item.nomorNib}</span>
              )}
            </div>
            <div>
              <span class="text-xs text-ink-faint font-medium block">Jam Operasional</span>
              <span class="text-sm font-bold text-ink">
                {item.jamOperasional?.buka && item.jamOperasional?.tutup
                  ? (item.jamOperasional.buka === "00:00" && item.jamOperasional.tutup === "23:59"
                      ? "24 Jam"
                      : `${item.jamOperasional.buka} - ${item.jamOperasional.tutup}`)
                  : "Belum tersedia"}
              </span>
            </div>
          </div>

          <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            {item.telepon && (
              <a href={`https://wa.me/${item.telepon}`} target="_blank" class="w-full bg-sawah-500 hover:bg-sawah-600 text-white font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all text-sm">
                💬 Hubungi WhatsApp
              </a>
            )}
            {item.maps && (
              <a href={item.maps} target="_blank" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all text-sm">
                📍 Buka di Google Maps
              </a>
            )}
            {item.telepon && (
              <button onclick={`navigator.clipboard.writeText('${item.telepon}'); alert('Nomor kontak berhasil disalin!');`} class="w-full bg-canvas hover:bg-line/40 text-ink-soft font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all text-sm border border-line">
                📋 Salin Kontak
              </button>
            )}
            <button onclick={`if(navigator.share){navigator.share({title: '${item.nama}', url: window.location.href})}else{alert('Fitur bagikan tidak didukung di browser ini.')}`} class="w-full bg-canvas hover:bg-line/40 text-ink-soft font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-all text-sm border border-line">
              🔗 Bagikan UMKM
            </button>
          </div>
        </div>
      </div>

      {umkmSejenis.length > 0 && (
        <div class="space-y-6 pt-4">
          <h2 class="text-2xl font-bold text-ink">UMKM Sejenis di Kategori {item.kategori}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {umkmSejenis.map((sejenis, i) => (
              <UmkmCard item={sejenis} index={i} variant="compact" />
            ))}
          </div>
        </div>
      )}

    </div>
  </main>
</Layout>

<script define:vars={{ jamOperasional: item.jamOperasional }}>
  function cekStatusBuka(jadwal) {
    if (!jadwal || !jadwal.hariBuka || !jadwal.buka || !jadwal.tutup) {
      return { buka: false, label: "Jam tidak tersedia" };
    }

    const now = new Date();
    const hariIni = now.getDay();

    if (!jadwal.hariBuka.includes(hariIni)) {
      return { buka: false, label: "Tutup Hari Ini" };
    }

    const [jamBuka, menitBuka] = jadwal.buka.split(":").map(Number);
    const [jamTutup, menitTutup] = jadwal.tutup.split(":").map(Number);
    const totalMenitSekarang = now.getHours() * 60 + now.getMinutes();
    const totalMenitBuka = jamBuka * 60 + menitBuka;
    const totalMenitTutup = jamTutup * 60 + menitTutup;

    const sedangBuka = totalMenitSekarang >= totalMenitBuka && totalMenitSekarang <= totalMenitTutup;

    return {
      buka: sedangBuka,
      label: sedangBuka ? `Buka · Tutup ${jadwal.tutup}` : "Tutup",
    };
  }

  const statusEl = document.getElementById("statusBukaTutup");
  if (statusEl) {
    const status = cekStatusBuka(jamOperasional);
    const dotColor = status.buka ? "bg-sawah-500" : "bg-alert-500";
    const textColor = status.buka ? "text-sawah-600" : "text-alert-600";

    statusEl.className = `absolute bottom-4 left-4 inline-flex items-center gap-1.5 bg-surface/90 backdrop-blur-md ${textColor} text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm`;
    statusEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span> ${status.label}`;
  }
</script>