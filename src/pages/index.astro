---
import Layout from '../layouts/Layout.astro';
import UmkmCard from '../components/umkm/UmkmCard.astro';
import { getUmkmData } from '../lib/sanity';

const umkmData = await getUmkmData();
const totalUmkm = umkmData.length;
const totalKategori = new Set(umkmData.map(u => u.kategori)).size;
const totalNib = umkmData.filter(u => u.nib).length;

const listKategoriUnik = [...new Set(umkmData.map(u => u.kategori))];
const sudahAdaLainnya = listKategoriUnik.some((k) => k.toLowerCase() === 'lainnya');
const semuaKategoriFilter = sudahAdaLainnya ? listKategoriUnik : [...listKategoriUnik, 'Lainnya'];

const kategoriLabels: Record<string, string> = { semua: 'Semua Kategori' };
semuaKategoriFilter.forEach((k) => { kategoriLabels[k.toLowerCase()] = k; });
---

<Layout title="Direktori UMKM Desa Banyakprodo" description="Mendukung potensi produk lokal, kerajinan, dan kuliner unggulan warga Desa Banyakprodo, Kecamatan Tirtomoyo, Wonogiri." gambar="/peta-og.jpg">
  <main class="min-h-screen bg-canvas text-ink">

    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-gradient-to-br from-indigo-700 to-indigo-500 text-white py-16 px-4 sm:px-6 lg:px-8 shadow-md">
      <div class="batik-motif absolute inset-0 pointer-events-none"></div>
      <div class="relative max-w-6xl mx-auto text-center space-y-4">
        <span class="inline-block bg-soga-500/25 backdrop-blur-sm text-soga-50 text-sm font-semibold px-4 py-1.5 rounded-full border border-soga-100/30">
          Official Directory • KKN Universitas Diponegoro
        </span>
        <h1 class="hero-shadow text-4xl sm:text-5xl font-extrabold tracking-tight">
          Direktori UMKM Desa Banyakprodo
        </h1>
        <p class="text-indigo-50 text-lg max-w-2xl mx-auto font-light">
          Mendukung potensi produk lokal, kerajinan, dan kuliner unggulan warga Desa Banyakprodo, Kecamatan Tirtomoyo, Wonogiri.
        </p>
      </div>
    </section>

    <!-- STATISTIK RINGKAS -->
    <section class="max-w-6xl mx-auto -mt-8 px-4 sm:px-6 relative z-10">
      <div class="grid grid-cols-3 divide-x divide-line bg-surface p-4 sm:p-6 rounded-2xl shadow-lg border border-line">
        <div class="text-center px-1 sm:px-3 flex flex-col items-center">
          <span class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-indigo-50 text-indigo-600 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.5L12 4l9 5.5M5 10v9a1 1 0 001 1h4v-5h4v5h4a1 1 0 001-1v-9" />
            </svg>
          </span>
          <p class="text-xl sm:text-3xl font-black text-indigo-600 leading-none">{totalUmkm}</p>
          <p class="text-[10px] sm:text-sm text-ink-soft font-medium mt-1.5 leading-tight">Total UMKM Terdata</p>
        </div>
        <div class="text-center px-1 sm:px-3 flex flex-col items-center">
          <span class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-indigo-50 text-indigo-600 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 12.5l-8-8H4v8.5l8 8a2 2 0 002.83 0l5.67-5.67a2 2 0 000-2.83z" />
              <circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <p class="text-xl sm:text-3xl font-black text-indigo-600 leading-none">{totalKategori}</p>
          <p class="text-[10px] sm:text-sm text-ink-soft font-medium mt-1.5 leading-tight">Sektor Kategori</p>
        </div>
        <div class="text-center px-1 sm:px-3 flex flex-col items-center">
          <span class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-indigo-50 text-indigo-600 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <p class="text-xl sm:text-3xl font-black text-indigo-600 leading-none">{totalNib}</p>
          <p class="text-[10px] sm:text-sm text-ink-soft font-medium mt-1.5 leading-tight">Bersertifikat NIB</p>
        </div>
      </div>
    </section>

    <!-- TENTANG DESA & PETA -->
    <section id="tentang-desa" class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <div class="bg-surface rounded-3xl p-8 md:p-12 shadow-sm border border-line flex flex-col lg:flex-row gap-10 items-center">

        <div class="lg:w-1/2 space-y-5">
          <div class="inline-flex items-center justify-center p-3 bg-indigo-50 text-indigo-600 rounded-xl mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-ink">Tentang Desa Banyakprodo</h2>
          <p class="text-ink-soft leading-relaxed">
            Desa Banyakprodo terletak di Kecamatan Tirtomoyo, Kabupaten Wonogiri. Di wilayah ini berkembang berbagai Usaha Mikro, Kecil, dan Menengah (UMKM) yang menjadi penopang perekonomian masyarakat setempat.
          </p>
          <p class="text-ink-soft leading-relaxed">
            Keberadaan UMKM ini tidak hanya membantu meningkatkan pendapatan warga, tetapi juga mendorong terciptanya lapangan kerja baru serta memperkenalkan kearifan lokal Banyakprodo ke khalayak luas.
          </p>
        </div>

        <div class="lg:w-1/2 w-full">
          <div class="relative bg-surface rounded-2xl p-3 border border-line shadow-sm group">

            <div id="openModalBtn" class="absolute top-6 right-6 z-10 bg-surface/90 hover:bg-surface text-ink-soft text-xs font-semibold px-3 py-1.5 rounded-lg shadow-md border border-line flex items-center gap-1.5 cursor-pointer transition-all hover:scale-105">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
              Klik untuk perbesar
            </div>

            <div id="mapThumb" class="relative overflow-hidden rounded-xl h-72 sm:h-80 w-full bg-canvas flex items-center justify-center cursor-pointer">
              <img
                src="/peta-banyakprodo.jpeg"
                alt="Peta Wilayah Desa Banyakprodo"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>

            <div class="mt-3 flex items-center justify-between px-2">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-600 animate-pulse"></span>
                <span class="text-xs font-bold text-ink-soft">Peta Wilayah Desa Banyakprodo, Tirtomoyo</span>
              </div>
              <span class="text-xs text-ink-faint font-medium">KKN Tim II Undip</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- KATALOG UMKM DENGAN LIVE SEARCH, FILTER & PAGINATION -->
    <section id="katalog" class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-ink">Daftar Usaha Lokal</h2>
        <p class="text-ink-soft mt-2">Katalog lengkap produk kebanggaan warga Banyakprodo</p>
      </div>

      <div class="max-w-xl mx-auto mb-6 relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink-faint" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="searchInput"
          placeholder="Cari nama UMKM atau produk..."
          class="w-full pl-12 pr-4 py-3.5 rounded-2xl border border-line focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none shadow-sm transition-all text-ink bg-surface"
        />
      </div>

      <!-- FILTER: VERSI HP (dropdown gaya SAHARA) -->
      <div class="sm:hidden max-w-xl mx-auto mb-8 flex items-center gap-2">
        <div class="relative flex-1">
          <button
            id="kategoriDropdownBtn"
            type="button"
            class="w-full flex items-center justify-between gap-2 px-4 py-3 rounded-xl border border-line bg-surface text-sm font-semibold text-ink shadow-sm"
          >
            <span class="flex items-center gap-2 truncate">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16l-6 7v5l-4 2v-7L4 5z" />
              </svg>
              <span id="kategoriDropdownLabel" class="truncate">Semua Kategori</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ink-faint shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <div id="kategoriDropdownPanel" class="hidden absolute z-20 mt-2 w-full bg-surface border border-line rounded-xl shadow-lg py-2 max-h-72 overflow-auto">
            <button class="filter-btn-mobile w-full text-left px-4 py-2.5 text-sm font-medium text-ink hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-kategori="semua">Semua Kategori</button>
            {semuaKategoriFilter.map((kategori) => (
              <button class="filter-btn-mobile w-full text-left px-4 py-2.5 text-sm font-medium text-ink hover:bg-indigo-50 hover:text-indigo-600 transition-colors" data-kategori={kategori.toLowerCase()}>{kategori}</button>
            ))}
          </div>
        </div>
        <button id="filterBukaSekarangBtnMobile" data-active="false" class="shrink-0 flex items-center gap-1.5 px-4 py-3 rounded-xl border border-line bg-surface text-ink-soft text-sm font-semibold shadow-sm transition-colors">
          <span class="w-2 h-2 rounded-full bg-sawah-500"></span>
          Buka
        </button>
      </div>

      <!-- FILTER: VERSI LAPTOP (pill row) -->
      <div class="hidden sm:flex flex-wrap justify-center gap-2 mb-12" id="filterContainer">
        <button class="filter-btn active bg-indigo-600 text-white border-transparent px-5 py-2 rounded-full text-sm font-semibold transition-colors shadow-sm" data-kategori="semua">
          Semua
        </button>
        {semuaKategoriFilter.map((kategori) => (
          <button class="filter-btn bg-surface text-ink-soft border-line border hover:bg-indigo-50 hover:text-indigo-600 px-5 py-2 rounded-full text-sm font-semibold transition-colors shadow-sm" data-kategori={kategori.toLowerCase()}>
            {kategori}
          </button>
        ))}
        <button id="filterBukaSekarangBtn" data-active="false" class="bg-surface text-ink-soft border-line border hover:bg-sawah-50 hover:text-sawah-600 px-5 py-2 rounded-full text-sm font-semibold transition-colors shadow-sm inline-flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-sawah-500"></span>
          Buka Sekarang
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="umkmGrid">
        {umkmData.map((item, i) => (
          <UmkmCard item={item} index={i} variant="full" />
        ))}
      </div>

      <div id="noResults" class="hidden text-center py-12">
        <p class="text-ink-soft text-lg">Maaf, UMKM yang kamu cari tidak ditemukan.</p>
        <button id="resetSearch" class="mt-4 text-indigo-600 font-semibold hover:underline">Reset Pencarian</button>
      </div>

      <p id="paginationInfo" class="text-center text-sm text-ink-soft mt-8"></p>
      <div id="paginationControls" class="flex items-center justify-center gap-1.5 mt-4"></div>
    </section>

    <!-- MODAL POPUP PREVIEW PETA -->
    <div id="mapModal" class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-surface rounded-3xl max-w-4xl w-full overflow-hidden shadow-2xl relative flex flex-col max-h-[90vh]">

        <div class="flex items-center justify-between px-6 py-4 border-b border-line">
          <h3 class="font-bold text-lg text-ink">Peta Persebaran & Wilayah Desa Banyakprodo</h3>
          <button id="closeModalBtn" class="w-9 h-9 rounded-full bg-canvas hover:bg-line text-ink-soft flex items-center justify-center font-bold text-lg transition-colors">
            ✕
          </button>
        </div>

        <div class="p-4 overflow-auto flex-1 flex items-center justify-center bg-canvas">
          <img src="/peta-banyakprodo.jpeg" alt="Peta Desa Banyakprodo Full" class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-sm" />
        </div>

      </div>
    </div>

    <!-- SCRIPT LOGIKA LIVE SEARCH, FILTER, PAGINATION & MODAL PETA -->
    <script define:vars={{ umkmDataForFilter: umkmData.map(u => ({ id: u.id, jamOperasional: u.jamOperasional })), kategoriLabels }}>
      document.addEventListener('DOMContentLoaded', () => {
        const mapModal = document.getElementById('mapModal');
        const mapThumb = document.getElementById('mapThumb');
        const openModalBtn = document.getElementById('openModalBtn');
        const closeModalBtn = document.getElementById('closeModalBtn');

        function openModal() {
          mapModal?.classList.remove('hidden');
          mapModal?.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
        function closeModal() {
          mapModal?.classList.add('hidden');
          mapModal?.classList.remove('flex');
          document.body.style.overflow = 'auto';
        }
        mapThumb?.addEventListener('click', openModal);
        openModalBtn?.addEventListener('click', openModal);
        closeModalBtn?.addEventListener('click', closeModal);
        mapModal?.addEventListener('click', (e) => {
          if (e.target === mapModal) closeModal();
        });

        function cekStatusBuka(jadwal) {
          if (!jadwal || !jadwal.hariBuka || !jadwal.buka || !jadwal.tutup) return false;
          const now = new Date();
          const hariIni = now.getDay();
          if (!jadwal.hariBuka.includes(hariIni)) return false;
          const [jamBuka, menitBuka] = jadwal.buka.split(":").map(Number);
          const [jamTutup, menitTutup] = jadwal.tutup.split(":").map(Number);
          const totalMenitSekarang = now.getHours() * 60 + now.getMinutes();
          const totalMenitBuka = jamBuka * 60 + menitBuka;
          const totalMenitTutup = jamTutup * 60 + menitTutup;
          return totalMenitSekarang >= totalMenitBuka && totalMenitSekarang <= totalMenitTutup;
        }

        const petaStatusBuka = {};
        umkmDataForFilter.forEach((u) => {
          petaStatusBuka[u.id] = cekStatusBuka(u.jamOperasional);
        });

        const searchInput = document.getElementById('searchInput');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const filterBtnsMobile = document.querySelectorAll('.filter-btn-mobile');
        const filterBukaSekarangBtn = document.getElementById('filterBukaSekarangBtn');
        const filterBukaSekarangBtnMobile = document.getElementById('filterBukaSekarangBtnMobile');
        const kategoriDropdownBtn = document.getElementById('kategoriDropdownBtn');
        const kategoriDropdownPanel = document.getElementById('kategoriDropdownPanel');
        const kategoriDropdownLabel = document.getElementById('kategoriDropdownLabel');
        const cards = document.querySelectorAll('.umkm-card');
        const noResults = document.getElementById('noResults');
        const resetSearch = document.getElementById('resetSearch');
        const paginationInfo = document.getElementById('paginationInfo');
        const paginationControls = document.getElementById('paginationControls');

        const PER_PAGE = 9;
        let currentCategory = 'semua';
        let searchQuery = '';
        let hanyaBuka = false;
        let currentPage = 1;

        function ambilIdDariCard(card) {
          const link = card.querySelector('a[href^="/umkm/"]');
          if (!link) return null;
          return link.getAttribute('href').replace('/umkm/', '');
        }

        function setActiveKategoriUI(nilai) {
          filterBtns.forEach((b) => {
            const aktif = b.getAttribute('data-kategori') === nilai;
            b.classList.toggle('bg-indigo-600', aktif);
            b.classList.toggle('text-white', aktif);
            b.classList.toggle('border-transparent', aktif);
            b.classList.toggle('bg-surface', !aktif);
            b.classList.toggle('text-ink-soft', !aktif);
            b.classList.toggle('border-line', !aktif);
          });
          filterBtnsMobile.forEach((b) => {
            const aktif = b.getAttribute('data-kategori') === nilai;
            b.classList.toggle('bg-indigo-50', aktif);
            b.classList.toggle('text-indigo-600', aktif);
          });
          if (kategoriDropdownLabel) {
            kategoriDropdownLabel.textContent = kategoriLabels[nilai] || 'Semua Kategori';
          }
        }

        function setBukaUI(aktif) {
          [filterBukaSekarangBtn, filterBukaSekarangBtnMobile].forEach((btn) => {
            if (!btn) return;
            btn.setAttribute('data-active', String(aktif));
            btn.classList.toggle('bg-sawah-500', aktif);
            btn.classList.toggle('text-white', aktif);
            btn.classList.toggle('border-transparent', aktif);
            btn.classList.toggle('bg-surface', !aktif);
            btn.classList.toggle('text-ink-soft', !aktif);
            btn.classList.toggle('border-line', !aktif);
          });
        }

        function renderPaginationControls(totalPages) {
          if (!paginationControls) return;
          if (totalPages <= 1) { paginationControls.innerHTML = ''; return; }

          let pages = [];
          if (totalPages <= 7) {
            pages = Array.from({ length: totalPages }, (_, i) => i + 1);
          } else {
            const set = new Set([1, 2, totalPages - 1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
            pages = [...set].filter((p) => p >= 1 && p <= totalPages).sort((a, b) => a - b);
          }

          const tombol = (label, disabled, id) =>
            `<button id="${id}" ${disabled ? 'disabled' : ''} class="w-9 h-9 rounded-lg border border-line bg-surface text-ink-soft hover:bg-indigo-50 hover:text-indigo-600 flex items-center justify-center transition-colors disabled:opacity-40 disabled:pointer-events-none text-sm">${label}</button>`;

          let html = tombol('‹', currentPage === 1, 'prevPageBtn');
          let prevP = 0;
          pages.forEach((p) => {
            if (prevP && p - prevP > 1) {
              html += `<span class="w-9 h-9 flex items-center justify-center text-ink-faint text-sm">…</span>`;
            }
            const aktif = p === currentPage;
            html += `<button class="page-btn ${aktif ? 'bg-indigo-600 text-white border-transparent' : 'bg-surface text-ink-soft border-line hover:bg-indigo-50 hover:text-indigo-600'} w-9 h-9 rounded-lg border text-sm font-semibold transition-colors" data-page="${p}">${p}</button>`;
            prevP = p;
          });
          html += tombol('›', currentPage === totalPages, 'nextPageBtn');

          paginationControls.innerHTML = html;

          document.getElementById('prevPageBtn')?.addEventListener('click', () => { currentPage--; filterAndPaginate(true); });
          document.getElementById('nextPageBtn')?.addEventListener('click', () => { currentPage++; filterAndPaginate(true); });
          paginationControls.querySelectorAll('.page-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
              currentPage = parseInt(btn.getAttribute('data-page'), 10);
              filterAndPaginate(true);
            });
          });
        }

        function filterAndPaginate(scrollToTop) {
          const matched = [];
          cards.forEach((card) => {
            const nama = card.getAttribute('data-nama') || '';
            const kategori = card.getAttribute('data-kategori') || '';
            const id = ambilIdDariCard(card);

            const matchesSearch = nama.includes(searchQuery);
            const matchesCategory = currentCategory === 'semua' || kategori === currentCategory;
            const matchesBuka = !hanyaBuka || (id && petaStatusBuka[id]);

            if (matchesSearch && matchesCategory && matchesBuka) matched.push(card);
          });

          const totalItems = matched.length;
          const totalPages = Math.max(1, Math.ceil(totalItems / PER_PAGE));
          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          cards.forEach((card) => { card.style.display = 'none'; });

          const start = (currentPage - 1) * PER_PAGE;
          const end = Math.min(start + PER_PAGE, totalItems);
          matched.slice(start, end).forEach((card) => { card.style.display = 'flex'; });

          if (totalItems === 0) {
            noResults?.classList.remove('hidden');
          } else {
            noResults?.classList.add('hidden');
          }

          if (paginationInfo) {
            paginationInfo.textContent = totalItems === 0 ? '' : `Menampilkan ${start + 1}\u2013${end} dari ${totalItems} UMKM`;
          }
          renderPaginationControls(totalPages);

          if (scrollToTop) {
            document.getElementById('katalog')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        function setKategori(nilai) {
          currentCategory = nilai;
          currentPage = 1;
          setActiveKategoriUI(nilai);
          kategoriDropdownPanel?.classList.add('hidden');
          filterAndPaginate(false);
        }

        function toggleBuka() {
          hanyaBuka = !hanyaBuka;
          currentPage = 1;
          setBukaUI(hanyaBuka);
          filterAndPaginate(false);
        }

        searchInput?.addEventListener('input', (e) => {
          searchQuery = e.target.value.toLowerCase().trim();
          currentPage = 1;
          filterAndPaginate(false);
        });

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => setKategori(btn.getAttribute('data-kategori') || 'semua'));
        });
        filterBtnsMobile.forEach((btn) => {
          btn.addEventListener('click', () => setKategori(btn.getAttribute('data-kategori') || 'semua'));
        });

        kategoriDropdownBtn?.addEventListener('click', () => {
          kategoriDropdownPanel?.classList.toggle('hidden');
        });
        document.addEventListener('click', (e) => {
          if (!kategoriDropdownBtn?.contains(e.target) && !kategoriDropdownPanel?.contains(e.target)) {
            kategoriDropdownPanel?.classList.add('hidden');
          }
        });

        filterBukaSekarangBtn?.addEventListener('click', toggleBuka);
        filterBukaSekarangBtnMobile?.addEventListener('click', toggleBuka);

        resetSearch?.addEventListener('click', () => {
          searchInput.value = '';
          searchQuery = '';
          setKategori('semua');
        });

        filterAndPaginate(false);
      });
    </script>

  </main>
</Layout>