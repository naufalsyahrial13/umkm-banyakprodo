---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getKegiatanData } from '../lib/sanity';

Astro.response.headers.set('CDN-Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

const kegiatanData = await getKegiatanData();

const KATEGORI_WARNA: Record<string, string> = {
  Olahraga: 'bg-sawah-500',
  Perlombaan: 'bg-soga-500',
  Pengumuman: 'bg-indigo-600',
  'Gotong Royong': 'bg-sawah-500',
  Pertemuan: 'bg-indigo-600',
  Lainnya: 'bg-ink',
};

function formatTanggal(iso: string) {
  return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
}

function cuplikan(teks: string, panjang = 160) {
  if (!teks) return '';
  if (teks.length <= panjang) return teks;
  return teks.slice(0, panjang).replace(/\s+\S*$/, '') + '...';
}
---

<Layout title="Kegiatan Terkini - UMKM Banyakprodo" description="Info kegiatan terbaru Desa Banyakprodo">
  <main class="min-h-screen bg-canvas py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      <Breadcrumb items={[{ label: "Beranda", href: "/" }, { label: "Kegiatan Terkini" }]} />

      <div>
        <h1 class="text-3xl font-extrabold text-ink">Kegiatan Terkini</h1>
        <p class="text-ink-soft mt-1">Info & dokumentasi kegiatan warga Desa Banyakprodo.</p>
      </div>

      {kegiatanData.length === 0 ? (
        <div class="bg-surface rounded-3xl p-10 text-center border border-line">
          <p class="text-ink-faint font-medium">Belum ada kegiatan yang diposting.</p>
        </div>
      ) : (
        <div class="space-y-4">
          {kegiatanData.map((k) => (
            
              <a href={k.slug ? `/kegiatan/${k.slug}` : '#'}
              class="group flex flex-col sm:flex-row gap-4 bg-surface rounded-2xl border border-line shadow-sm hover:shadow-md transition-shadow overflow-hidden p-4"
            >
              {k.foto ? (
                <img src={k.fotoThumb || k.foto} alt={k.judul} loading="lazy" decoding="async" class="w-full sm:w-48 h-40 sm:h-32 object-cover rounded-xl flex-shrink-0" />
              ) : (
                <div class="w-full sm:w-48 h-40 sm:h-32 bg-canvas rounded-xl flex items-center justify-center text-ink-faint text-xs flex-shrink-0">
                  Tidak ada foto
                </div>
              )}
              <div class="flex-1 space-y-1.5 min-w-0">
                <div class="flex items-center gap-3 flex-wrap">
                  <span class={`${KATEGORI_WARNA[k.kategori] || 'bg-ink'} text-white text-xs font-bold px-2.5 py-1 rounded-lg`}>
                    {k.kategori}
                  </span>
                  <span class="text-ink-faint text-xs font-medium">{formatTanggal(k.tanggal)}</span>
                </div>
                <h2 class="text-lg font-bold text-ink leading-snug group-hover:text-indigo-600 transition-colors">{k.judul}</h2>
                <p class="text-ink-soft text-sm leading-relaxed">{cuplikan(k.isi)}</p>
                <span class="text-indigo-600 text-sm font-bold inline-block pt-1">Baca selengkapnya →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>