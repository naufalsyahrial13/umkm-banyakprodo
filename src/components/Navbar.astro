---
// src/components/Navbar.astro
const { pathname } = Astro.url;

const tautan = [
  { href: "/", label: "Beranda" },
  { href: "/#katalog", label: "Katalog UMKM" },
  { href: "/kegiatan", label: "Kegiatan Terkini" },
  { href: "/informasi", label: "Informasi" },
];

const GITHUB_URL = "https://github.com/naufalsyahrial13/umkm-banyakprodo";
const INSTAGRAM_URL = "https://www.instagram.com/desa_banyakprodo";
---
<nav class="bg-surface/95 backdrop-blur-md border-b border-line sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
        <svg viewBox="0 0 64 64" class="h-9 w-9 rounded-lg shadow-sm transition-transform group-hover:scale-105">
          <rect width="64" height="64" rx="14" fill="#2D3B5C"/>
          <g transform="rotate(-14 32 32)">
            <path d="M8 20 L26 10 L35 18 L35 33 Q35 39 29 41 L14 47 Q8 45 8 38 Z" fill="#FFFFFF"/>
            <path d="M26 10 L35 18 L29 20 Z" fill="#B5652E" opacity="0.85"/>
            <line x1="12" y1="34" x2="21" y2="25" stroke="#B5652E" stroke-width="1.4"/>
            <line x1="16" y1="39" x2="26" y2="28" stroke="#B5652E" stroke-width="1.4"/>
            <line x1="20" y1="43" x2="30" y2="31" stroke="#B5652E" stroke-width="1.4"/>
            <circle cx="14" cy="24" r="1.4" fill="#B5652E" opacity="0.75"/>
            <circle cx="22" cy="18" r="1.4" fill="#B5652E" opacity="0.75"/>
            <circle cx="19" cy="32" r="1.4" fill="#B5652E" opacity="0.6"/>
            <ellipse cx="48" cy="29" rx="14" ry="3.8" fill="#FFFFFF"/>
            <path d="M34 29 Q35 45 48 48 Q61 45 62 29 Z" fill="#FFFFFF"/>
            <circle cx="43" cy="37" r="3.1" fill="#B5652E"/>
            <circle cx="52" cy="39" r="2.7" fill="#B5652E"/>
            <circle cx="48" cy="34" r="2.3" fill="#B5652E" opacity="0.9"/>
            <path d="M41 18 Q39 12 42 7" stroke="#FFFFFF" stroke-width="1.8" fill="none" opacity="0.85"/>
            <path d="M53 18 Q55 12 52 7" stroke="#FFFFFF" stroke-width="1.8" fill="none" opacity="0.85"/>
          </g>
        </svg>
        <span class="font-bold text-ink text-lg font-display group-hover:text-indigo-600 transition-colors">UMKM Banyakprodo</span>
      </a>

      <div class="flex items-center gap-1 sm:gap-2">

        <!-- Menu desktop -->
        <div class="hidden md:flex space-x-1 items-center">
          {tautan.map((t) => (
            <a href={t.href} class="text-ink-soft hover:text-indigo-600 hover:bg-indigo-50 px-4 py-2 rounded-lg text-sm font-semibold transition-colors">{t.label}</a>
          ))}
          <a href="/tentang" class={`ml-2 px-4 py-2 rounded-full text-sm font-bold border transition-colors ${pathname === '/tentang' ? 'bg-soga-500 text-white border-soga-500' : 'bg-soga-50 text-soga-600 border-soga-100 hover:bg-soga-100'}`}>
            Tentang Kami
          </a>
        </div>

        <!-- Ikon sosial + bantuan: selalu tampil, di laptop maupun HP -->
        <div class="flex items-center gap-1 ml-1 pl-1 sm:ml-2 sm:pl-2 border-l border-line">
          <a href="/bantuan" aria-label="Bantuan" class="w-9 h-9 inline-flex items-center justify-center rounded-lg text-ink-soft hover:text-white hover:bg-indigo-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 9a2.5 2.5 0 015 0c0 1.5-2.5 2-2.5 3.5"/>
              <circle cx="12" cy="17" r="0.6" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram Desa Banyakprodo" class="w-9 h-9 inline-flex items-center justify-center rounded-lg text-ink-soft hover:text-white hover:bg-gradient-to-br hover:from-soga-500 hover:to-indigo-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="Source code di GitHub" class="w-9 h-9 inline-flex items-center justify-center rounded-lg text-ink-soft hover:text-white hover:bg-ink transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
              <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.39 7.86 10.91.57.1.79-.25.79-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 015.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.8 1.19 1.83 1.19 3.09 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.21.66.8.55C20.71 21.38 24 17.08 24 12 24 5.73 18.77.5 12 .5z"/>
            </svg>
          </a>
        </div>

        <!-- Tombol hamburger mobile -->
        <button id="navToggle" type="button" aria-label="Buka menu navigasi" aria-expanded="false" class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-ink-soft hover:bg-canvas transition-colors">
          <svg id="iconMenuBuka" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="iconMenuTutup" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Panel menu mobile -->
    <div id="navPanel" class="md:hidden hidden pb-4">
      <div class="flex flex-col gap-1 pt-1 border-t border-line">
        {tautan.map((t) => (
          <a href={t.href} class="text-ink-soft hover:text-indigo-600 hover:bg-canvas px-3 py-3 rounded-lg text-sm font-semibold transition-colors mt-1">{t.label}</a>
        ))}
        <a href="/tentang" class="text-soga-600 bg-soga-50 hover:bg-soga-100 px-3 py-3 rounded-lg text-sm font-bold transition-colors mt-1">
          Tentang Kami
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const navToggle = document.getElementById('navToggle');
  const navPanel = document.getElementById('navPanel');
  const iconBuka = document.getElementById('iconMenuBuka');
  const iconTutup = document.getElementById('iconMenuTutup');

  navToggle?.addEventListener('click', () => {
    const sedangTerbuka = !navPanel?.classList.contains('hidden');
    navPanel?.classList.toggle('hidden');
    iconBuka?.classList.toggle('hidden');
    iconTutup?.classList.toggle('hidden');
    navToggle.setAttribute('aria-expanded', String(!sedangTerbuka));
  });

  navPanel?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      navPanel.classList.add('hidden');
      iconBuka?.classList.remove('hidden');
      iconTutup?.classList.add('hidden');
      navToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>