---
interface Props {
  icon: string;
  class?: string;
}
const { icon, class: className = 'h-4 w-4' } = Astro.props;

const paths: Record<string, string> = {
  kuliner: 'M4 12h16a8 4 0 01-16 0z M8 12V9 M12 12V7 M16 12V9',
  minuman: 'M6 3h12l-1.5 14a2 2 0 01-2 1.8h-5a2 2 0 01-2-1.8L6 3z M5 3h14',
  kerajinan: 'M4 8h16v4H4z M4 12h16v9H4z M12 8v13 M8 8a2 2 0 110-4c1.5 0 2 2 4 2 M16 8a2 2 0 100-4c-1.5 0-2 2-4 2',
  fashion: 'M12 4a2 2 0 10-2 2c0 .7.3 1.3.8 1.7L12 9l-7 4.5A2 2 0 004 15.2V16h16v-.8a2 2 0 00-1-1.7L12 9',
  furniture: 'M4 4v6h16V4 M6 10v10 M18 10v10 M4 15h16',
  pertanian: 'M12 21V9 M12 9c0-4 3-7 7-7 0 4-3 7-7 7z M12 13c0-3-2.5-5-6-5 0 3 2.5 5 6 5z',
  perikanan: 'M3 12c3-4 7-6 11-6 3 0 5 1.5 7 3-2 1.5-4 3-7 3-4 0-8-2-11-6z M14 9v6 M18 10l2-2 M18 14l2 2',
  lainnya: 'M20.5 12.5l-8-8H4v8.5l8 8a2 2 0 002.83 0l5.67-5.67a2 2 0 000-2.83z',
};

const d = paths[icon] || paths.lainnya;
---
<svg xmlns="http://www.w3.org/2000/svg" class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
  <path stroke-linecap="round" stroke-linejoin="round" d={d} />
  {icon === 'lainnya' && <circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none" />}
</svg>